# The projects of the open source page (`OpenSourceCatalog`), by group, in the order of the page. The key of a group is the ID of its section. The summaries are close to the descriptions of the repos.
#
# A group has two or three projects, or a multiple of four, so the cards fill the rows of the grid. The page has no Electron projects, like `electron-store`.

http: [
	{
		name: 'Got'
		repository: 'sindresorhus/got'
		summary: 'Human-friendly and powerful HTTP requests for Node.js.'
		language: 'TypeScript'
	}
	{
		name: 'Ky'
		repository: 'sindresorhus/ky'
		summary: 'A tiny and elegant HTTP client based on the Fetch API.'
		language: 'TypeScript'
	}
	# The following were intentionally excluded: is-online, public-ip, is-up.
	{
		name: 'normalize-url'
		repository: 'sindresorhus/normalize-url'
		summary: 'Normalize a URL.'
		language: 'JavaScript'
	}
	{
		name: 'fetch-extras'
		repository: 'sindresorhus/fetch-extras'
		summary: 'Useful utilities for working with Fetch.'
		language: 'JavaScript'
	}
]

promises: [
	{
		name: 'p-limit'
		repository: 'sindresorhus/p-limit'
		summary: 'Run promise-returning and async functions with limited concurrency.'
		language: 'JavaScript'
	}
	{
		name: 'p-queue'
		repository: 'sindresorhus/p-queue'
		summary: 'Promise queue with concurrency control.'
		language: 'TypeScript'
	}
	{
		name: 'p-map'
		repository: 'sindresorhus/p-map'
		summary: 'Map over promises concurrently.'
		language: 'JavaScript'
	}
	{
		name: 'p-retry'
		repository: 'sindresorhus/p-retry'
		summary: 'Retry a promise-returning or async function.'
		language: 'JavaScript'
	}
	{
		name: 'p-throttle'
		repository: 'sindresorhus/p-throttle'
		summary: 'Throttle promise-returning and async functions.'
		language: 'JavaScript'
	}
	# The following were intentionally excluded: pify, delay, Emittery, p-cancelable.
	{
		name: 'p-progress'
		repository: 'sindresorhus/p-progress'
		summary: 'Create a promise that reports progress.'
		language: 'TypeScript'
	}
	{
		name: 'p-memoize'
		repository: 'sindresorhus/p-memoize'
		summary: 'Memoize promise-returning and async functions.'
		language: 'TypeScript'
	}
	{
		name: 'p-event'
		repository: 'sindresorhus/p-event'
		summary: 'Promisify an event by waiting for it to be emitted.'
		language: 'JavaScript'
	}
]

command-line-tools: [
	{
		name: 'np'
		repository: 'sindresorhus/np'
		summary: 'A better “npm publish”.'
		language: 'JavaScript'
	}
	{
		name: 'Pure'
		repository: 'sindresorhus/pure'
		summary: 'Pretty, minimal, and fast Zsh prompt.'
		language: 'Shell'
	}
	{
		name: 'fkill'
		repository: 'sindresorhus/fkill-cli'
		summary: 'Fabulously kill processes. Cross-platform.'
		language: 'JavaScript'
	}
	# The following were intentionally excluded: fast-cli, speed-test.
	{
		name: 'emoj'
		repository: 'sindresorhus/emoj'
		summary: 'Find relevant emoji from text on the command-line.'
		language: 'TypeScript'
	}
]

command-line-apps: [
	{
		name: 'Chalk'
		repository: 'chalk/chalk'
		summary: 'Terminal string styling done right.'
		language: 'JavaScript'
	}
	{
		name: 'Ora'
		repository: 'sindresorhus/ora'
		summary: 'Elegant terminal spinner.'
		language: 'JavaScript'
	}
	{
		name: 'meow'
		repository: 'sindresorhus/meow'
		summary: 'A helper for command-line apps, like for their arguments and help text.'
		language: 'JavaScript'
	}
	{
		name: 'boxen'
		repository: 'sindresorhus/boxen'
		summary: 'Create boxes in the terminal.'
		language: 'JavaScript'
	}
	{
		name: 'log-update'
		repository: 'sindresorhus/log-update'
		summary: 'Log by overwriting the previous output in the terminal, like for progress bars.'
		language: 'JavaScript'
	}
	# The following were intentionally excluded: terminal-link, cli-spinners, update-notifier, yoctocolors, log-symbols.
	{
		name: 'string-width'
		repository: 'sindresorhus/string-width'
		summary: 'Get the visual width of a string.'
		language: 'JavaScript'
	}
	{
		name: 'figures'
		repository: 'sindresorhus/figures'
		summary: 'Unicode symbols with fallbacks for older terminals.'
		language: 'JavaScript'
	}
	{
		name: 'cli-truncate'
		repository: 'sindresorhus/cli-truncate'
		summary: 'Truncate a string to fit a specific number of columns.'
		language: 'JavaScript'
	}
]

files: [
	{
