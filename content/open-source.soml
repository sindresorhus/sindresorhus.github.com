		summary: 'Copy files.'
		language: 'JavaScript'
	}
	{
		name: 'move-file'
		repository: 'sindresorhus/move-file'
		summary: 'Move a file, directory, or symlink, also to another device.'
		language: 'JavaScript'
	}
	# The following was intentionally excluded: make-dir.
	{
		name: 'tempy'
		repository: 'sindresorhus/tempy'
		summary: 'Get a random temporary file or directory path.'
		language: 'JavaScript'
	}
]

system: [
	{
		name: 'Execa'
		repository: 'sindresorhus/execa'
